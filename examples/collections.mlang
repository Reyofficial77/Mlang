var fruits is ["apple", "banana", "cherry"]
show.log("Fruits:", fruits)

for each fruit in fruits:
    show.log("- " + fruit)

fruits.append("mango")
show.log("After adding mango:", fruits)
show.log("First two:", fruits[0:2])

var person is {"name": "Rey", "age": 20}
show.log("Name:", person["name"])
person["age"] is 21
show.log("Updated person:", person)

var total is 0
for i in range(1, 6):
    total += i
show.log("Sum from 1 to 5:", total)

for i in range(0, 10):
    if i is 3:
        continue
    if i is 6:
        break
    show.log("i =", i)
